pub enum FieldType: u8 {
    severity = 'S',
    localized_severity = 'V',
    code = 'C',
    message = 'M',
    detail = 'D',
    hint = 'H',
    position = 'P',
    internal_position = 'p',
    internal = 'q',
    where = 'W',
    schema = 's',
    table = 't',
    column = 'c',
    datatype = 'd',
    constraint = 'n',
    file = 'F',
    line = 'L',
    routine = 'R',
    _,
}
