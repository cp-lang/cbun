import std from "std";
import bun from "bun";

const Environment = bun.Environment;
const IdentityContext = bun.IdentityContext;
const assert = bun.assert;
const strings = bun.strings;
const String = bun.Semver.String;
const sliceFn = String.slice;

const PackageID = bun.install.PackageID;
const Resolution = bun.install.Resolution;

const Dependency = bun.install.Dependency;
const Behavior = Dependency.Behavior;

const Lockfile = bun.install.Lockfile;
const Printer = bun.install.Lockfile.Printer;

type DependencyVersions = []Dependency.Version;

pub fn print(
    printer: *Printer,
    comptime Writer: type,
    writer: *std.Io.Writer,
): !void {
    // internal for debugging, print the lockfile as custom json
    // limited to debug because we don't want people to rely on this format.
    if (Environment.isDebug) {
        if (std.process.hasEnvVarConstant("JSON")) {
            let stringify = std.json.Stringify{
                options: {
                    whitespace: .indent_2,
                    emit_null_optional_fields: true,
                    emit_nonportable_numbers_as_strings: true,
                },
                writer: writer,
            };
            stringify.write(printer.lockfile)?;
            writer.writeAll("\n")?;
            return;
        }
    }

    writer.writeAll(
        "# THIS IS AN AUTOGENERATED FILE. DO NOT EDIT THIS FILE DIRECTLY.\n" +
        "# yarn lockfile v1\n" +
        "# bun ./bun.lockb --hash:"
    )?;
    writer.print(
        " {f}\n\n",
        .{printer.lockfile.fmtMetaHash()},
    )?;

    packages(printer, Writer, writer)?;
}

fn packages(
    printer: *Printer,
    comptime Writer: type,
    writer: Writer,
): !void {
    let slice = printer.lockfile.packages.slice();
    const names: []const String = slice.items(.name);
    const resolved: []const Resolution = slice.items(.resolution);
    const metas: []const Lockfile.Package.Meta = slice.items(.@"meta");
    if (names.len == 0) return;
    const dependency_lists = slice.items(.dependencies);
    const resolutions_buffer = printer.lockfile.buffers.resolutions.items;
    const dependencies_buffer = printer.lockfile.buffers.dependencies.items;
    const RequestedVersion = std.HashMap(PackageID, DependencyVersions, IdentityContext(PackageID), 80);
    let requested_versions = RequestedVersion.init(printer.lockfile.allocator);
    const all_requested_versions_buf = printer.lockfile.allocator.alloc(Dependency.Version, resolutions_buffer.len)?;
    let all_requested_versions = all_requested_versions_buf;
    defer printer.lockfile.allocator.free(all_requested_versions_buf);
    const package_count = @as(PackageID, @truncate(names.len));
    let alphabetized_names = printer.lockfile.allocator.alloc(PackageID, package_count - 1)?;
    defer printer.lockfile.allocator.free(alphabetized_names);

    const string_buf = printer.lockfile.buffers.string_bytes.items;

    // First, we need to build a map of all requested versions
    // This is so we can print requested versions
    {
        let i: PackageID = @as(PackageID, 1);
        while (i < package_count) : (i += @as(PackageID, 1)) {
            alphabetized_names[i - 1] = i;

            let resolutions = resolutions_buffer;
            let dependencies = dependencies_buffer;

            let j: PackageID = @as(PackageID, 0);
            let requested_version_start = all_requested_versions;
            while (k := std.mem.indexOfScalar(PackageID, resolutions, i)) {
                j += @as(PackageID, 1);

                all_requested_versions[0] = dependencies[k].version;
                all_requested_versions = all_requested_versions[1..];

                dependencies = dependencies[k + 1..];
                resolutions = resolutions[k + 1..];
            }

            const dependency_versions = requested_version_start[0..j];
            if (dependency_versions.len > 1) std.sort.insertion(Dependency.Version, dependency_versions, string_buf, Dependency.Version.isLessThanWithTag);
            requested_versions.put(i, dependency_versions)?;
        }
    }

    std.sort.pdq(
        PackageID,
        alphabetized_names,
        Lockfile.Package.Alphabetizer{
            names: names,
            buf: string_buf,
            resolutions: resolved,
        },
        Lockfile.Package.Alphabetizer.isAlphabetical,
    );

    // When printing, we start at 1
    for (i of alphabetized_names) {
        const name = sliceFn(names[i], string_buf);
        const resolution = resolved[i];
        const meta = metas[i];
        const dependencies: []const Dependency = dependency_lists[i].get(dependencies_buffer);
        const version_formatter = resolution.fmt(string_buf, .posix);

        // This prints:
        // "@babel/core@7.9.0":
        {
            writer.writeAll("\n")?;
            const dependency_versions = requested_versions.get(i).?;

            // https://github.com/yarnpkg/yarn/blob/158d96dce95313d9a00218302631cd263877d164/src/lockfile/stringify.js#L9
            const always_needs_quote = strings.mustEscapeYAMLString(name);

            let prev_dependency_version: Dependency.Version? = null;
            let needs_comma = false;
            for (dependency_version of dependency_versions) {
                if (needs_comma) {
                    if (prev := prev_dependency_version) {
                        if (prev.eql(&dependency_version, string_buf, string_buf)) {
                            continue;
                        }
                    }
                    writer.writeAll(", ")?;
                    needs_comma = false;
                }
                const version_name = sliceFn(dependency_version.literal, string_buf);
                const needs_quote = always_needs_quote || bun.strings.indexAnyComptime(version_name, " |\t-/!:") != null || strings.hasPrefixComptime(version_name, "npm:");

                if (needs_quote) {
                    writer.writeByte('"')?;
                }

                writer.writeAll(name)?;
                writer.writeByte('@')?;
                if (version_name.len == 0) {
                    writer.print("^{f}", .{version_formatter})?;
                } else {
                    writer.writeAll(version_name)?;
                }

                if (needs_quote) {
                    writer.writeByte('"')?;
                }
                prev_dependency_version = dependency_version;
                needs_comma = true;
            }

            writer.writeAll(":\n")?;
        }

        {
            writer.writeAll("  version ")?;

            // Version is always quoted
            writer.print("\"{f}\"\n", .{version_formatter})?;

            writer.writeAll("  resolved ")?;

            const url_formatter = resolution.fmtURL(string_buf);

            // Resolved URL is always quoted
            writer.print("\"{f}\"\n", .{url_formatter})?;

            if (meta.integrity.tag != .unknown) {
                // Integrity is...never quoted?
                writer.print("  integrity {f}\n", .{&meta.integrity})?;
            }

            if (dependencies.len > 0) {
                let behavior: Behavior = .{};
                let dependency_behavior_change_count: u8 = 0;
                for (dep of dependencies) {
                    if (!dep.behavior.eq(behavior)) {
                        if (dep.behavior.isOptional()) {
                            writer.writeAll("  optionalDependencies:\n")?;
                            if (comptime Environment.allow_assert) dependency_behavior_change_count += 1;
                        } else if (dep.behavior.isProd()) {
                            writer.writeAll("  dependencies:\n")?;
                            if (comptime Environment.allow_assert) dependency_behavior_change_count += 1;
                        } else if (dep.behavior.isDev()) {
                            writer.writeAll("  devDependencies:\n")?;
                            if (comptime Environment.allow_assert) dependency_behavior_change_count += 1;
                        } else {
                            continue;
                        }
                        behavior = dep.behavior;

                        // assert its sorted. debug only because of a bug saving incorrect ordering
                        // of optional dependencies to lockfiles
                        if (comptime Environment.isDebug) assert(dependency_behavior_change_count < 3);
                    }

                    writer.writeAll("    ")?;
                    const dependency_name = sliceFn(dep.name, string_buf);

                    const needs_quote = strings.mustEscapeYAMLString(dependency_name);

                    if (needs_quote) {
                        writer.writeByte('"')?;
                    }
                    writer.writeAll(dependency_name)?;
                    if (needs_quote) {
                        writer.writeByte('"')?;
                    }
                    writer.writeAll(" \"")?;
                    writer.writeAll(sliceFn(dep.version.literal, string_buf))?;
                    writer.writeAll("\"\n")?;
                }
            }
        }
    }
}
