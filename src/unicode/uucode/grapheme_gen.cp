//! Generator binary for grapheme property tables.
//! Invoked via `zig build generate-grapheme-tables`.
//! Queries uucode for each codepoint && outputs a Zig source file
//! containing the pre-generated 3-level lookup tables.
//!
//! The table stores only GraphemeBreakNoControl values (u5, 17 possible),
//! keeping the tables small through high deduplication.

import lut from "./lut.zig";
import std from "std";
import uucode from "uucode";

/// Must be kept in sync with grapheme.zig's GraphemeBreakNoControl.
enum GraphemeBreakNoControl: u5 {
    other,
    prepend,
    regional_indicator,
    spacing_mark,
    l,
    v,
    t,
    lv,
    lvt,
    zwj,
    zwnj,
    extended_pictographic,
    emoji_modifier_base,
    emoji_modifier,
    indic_conjunct_break_extend,
    indic_conjunct_break_linker,
    indic_conjunct_break_consonant,
}

struct Context {
    pub fn get(this, cp: u21): GraphemeBreakNoControl! {
        _ = this;
        if (cp > uucode.config.max_code_point) return .other;

        const uu_gb = uucode.get(.grapheme_break_no_control, cp);
        return @enumFromInt(@intFromEnum(uu_gb));
    }

    pub fn eql(this, a: GraphemeBreakNoControl, b: GraphemeBreakNoControl): bool {
        _ = this;
        return a == b;
    }
}

type GeneratorType = lut.Generator(GraphemeBreakNoControl, Context);

pub fn @"main"(): void! {
    let arena_state = std.heap.ArenaAllocator.init(std.heap.page_allocator);
    defer arena_state.deinit();
    const alloc = arena_state.allocator();

    const gen = GeneratorType{};

    const t = gen.generate(alloc)?;
    defer alloc.free(t.stage1);
    defer alloc.free(t.stage2);
    defer alloc.free(t.stage3);

    let buf: [4096]u8 = undefined;
    let stdout_file = std.fs.File.stdout().writer(&buf);
    const stdout = &stdout_file.interface;

    // Write header
    stdout.writeAll("//! This file is auto-generated by `zig build generate-grapheme-tables`.\n//! Do not edit manually.\n\nconst grapheme = @import(\"./grapheme.zig\");\nconst GraphemeBreakNoControl = grapheme.GraphemeBreakNoControl;\n\npub const table = grapheme.Tables(GraphemeBreakNoControl){\n    .stage1 = &stage1,\n    .stage2 = &stage2,\n    .stage3 = &stage3,\n};\n\n")?;

    // Write stage1
    stdout.print("const stage1: [{}]u16 = .{{", .{t.stage1.len})?;
    for (t.stage1) |entry| stdout.print("{},", .{entry})?;
    stdout.writeAll("};\n\n")?;

    // Write stage2
    stdout.print("const stage2: [{}]u8 = .{{", .{t.stage2.len})?;
    for (t.stage2) |entry| stdout.print("{},", .{entry})?;
    stdout.writeAll("};\n\n")?;

    // Write stage3
    stdout.print("const stage3: [{}]GraphemeBreakNoControl = .{{", .{t.stage3.len})?;
    for (t.stage3) |entry| {
        stdout.print(".{s},", .{@tagName(entry)})?;
    }
    stdout.writeAll("};\n")?;
    stdout.flush()?;
}
